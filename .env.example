# NEXUS server configuration — copy to .env. Secrets stay on the server; the browser never receives them.
# (You can also set provider/model/keys at runtime in Settings → Model; those are saved to data/runtime-config.json.)

# demo | openai | anthropic   (demo = scripted demo brain, NOT an LLM, needs no credentials)
LLM_PROVIDER=demo

# OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio, vLLM…)
#   free & local example (Ollama):  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1:8b  OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-a-model-id
OPENAI_JSON_MODE=true

# Local models (Ollama / LM Studio) get a longer timeout unless LLM_TIMEOUT_MS is set: the first reply loads the model
LOCAL_LLM_TIMEOUT_MS=180000
# Where Settings → Model looks for Ollama
OLLAMA_URL=http://127.0.0.1:11434

# Anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=replace-with-a-current-model-id

# Optional live research: none | wikipedia (free, no key) | searxng | tavily
RESEARCH_PROVIDER=none
SEARXNG_URL=
TAVILY_API_KEY=

# Optional speech services (any OpenAI-compatible audio API, hosted or on this computer). Off by default:
# without them NEXUS uses this computer's speech voices and the browser's speech recognition.
#   TTS: POST {TTS_BASE_URL}/audio/speech — a generated voice; the robot's mouth follows the real audio level
#   STT: POST {STT_BASE_URL}/audio/transcriptions — voice input that also works in the desktop app
# Base URLs default to OPENAI_BASE_URL; OPENAI_API_KEY is reused ONLY when the base URL is the same server.
TTS_PROVIDER=none
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# mp3 | wav | opus
TTS_FORMAT=mp3
STT_PROVIDER=none
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
# optional language hint, e.g. en (blank = let the service detect it)
STT_LANGUAGE=

# Limits
PORT=8787
# LLM_TIMEOUT_MS=45000   (default; setting it also overrides the longer local-model timeout)
LLM_MAX_TOKENS=1400
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=1
HISTORY_MAX_MESSAGES=16
HISTORY_MAX_CHARS=12000
RATE_LIMIT_PER_MIN=30
# set to false to forbid changing provider/keys from the UI
ALLOW_RUNTIME_CONFIG=true
LOG_REQUESTS=true
# extra Host names the API accepts (comma-separated) — only needed behind a reverse proxy
ALLOWED_HOSTS=

# NEXUS server configuration. Copy this file to .env and fill in YOUR values.
# .env is ignored by git — never commit it. Placeholders only below; there are no real keys in this file.
# Secrets stay in the NEXUS server process; the browser never receives them.
# (Settings → Model / Voice in the app can also set these; they are saved to data/runtime-config.json, also git-ignored.)

# ─── Required for the AI companion ────────────────────────────────────────────────────────────────────────────
# Google Gemini — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A current Gemini text model. gemini-3.8-flash has a free tier (with per-minute/per-day limits) at the time of writing;
# check https://ai.google.dev/gemini-api/docs/pricing and change it here if Google retires it.
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs voice (OPTIONAL — without it NEXUS speaks with the browser's free built-in voices) — key at https://elevenlabs.io/app/settings/api-keys ; voice id from "My Voices" (or the picker in
# Settings → Voice → Speech services after the key is set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Text-to-speech model (ElevenLabs' documented default). Voice settings live in server/speech.ts (ELEVEN_VOICE_SETTINGS).
ELEVENLABS_MODEL=eleven_multilingual_v2

# Port of the NEXUS server (the app is served from it too: http://localhost:8787)
PORT=8787

# Personality: edit server/prompts/persona.ts, or point this at a plain-text file (≤ 6000 characters) to replace it
# NEXUS_PERSONA_FILE=C:\Users\you\nexus-persona.txt

# ─── Optional ─────────────────────────────────────────────────────────────────────────────────────────────────
# Brain: leave empty to pick Gemini automatically when GEMINI_API_KEY is set (otherwise the labelled demo brain, not an AI).
# demo | gemini | openai | anthropic
LLM_PROVIDER=

# OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio…), used when LLM_PROVIDER=openai
#   free & local example (Ollama):  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1:8b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_JSON_MODE=true
LOCAL_LLM_TIMEOUT_MS=180000
OLLAMA_URL=http://127.0.0.1:11434

# Anthropic, used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional live research: none | wikipedia (free, no key) | searxng | tavily
RESEARCH_PROVIDER=none
SEARXNG_URL=
TAVILY_API_KEY=

# Voice service: leave empty to pick ElevenLabs automatically when ELEVENLABS_API_KEY is set; otherwise this
# computer's built-in voices are used. none | elevenlabs | gemini | openai
TTS_PROVIDER=
# for TTS_PROVIDER=openai (any OpenAI-compatible /audio/speech API) or gemini (Gemini speech; reuses GEMINI_API_KEY)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_FORMAT=mp3
# TTS_STYLE=warm, bright and curious      (Gemini voice only)

# Optional server transcription (voice input that also works in the desktop app): none | openai
STT_PROVIDER=none
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=

# Limits and protection
# LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1400
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=1
HISTORY_MAX_MESSAGES=16
HISTORY_MAX_CHARS=12000
RATE_LIMIT_PER_MIN=30
# set to false to forbid changing provider/keys from the app
ALLOW_RUNTIME_CONFIG=true
# request log lines contain method, path, status and time only — never message text or keys
LOG_REQUESTS=true
# The API only answers requests for localhost and refuses cross-origin POSTs. Add extra host names (comma-separated)
# only if you put NEXUS behind your own reverse proxy, e.g. ALLOWED_HOSTS=nexus.example.com
ALLOWED_HOSTS=

# ─── Hosting online (Render etc.) — see docs/DEPLOY.md ─────────────────────────────────────────────────────────────
# PUBLIC_MODE=true listens on all interfaces, turns off settings changes from the browser, hides key hints and
# enables the daily budgets below. ALLOWED_ORIGINS lets your GitHub Pages site call the server from the browser.
# PUBLIC_MODE=true
# ALLOWED_ORIGINS=https://farhan19112014-byte.github.io
# DAILY_CHAT_LIMIT=400
# DAILY_CHAT_LIMIT_PER_VISITOR=60
# DAILY_SPEECH_CHAR_LIMIT=20000
